{
  "name": "plaud-v2",
  "version": "1.9.4",
  "description": "Plaud NotePin S — Local sync, decrypt & transcribe",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "publish": "export $(cat ../.env | grep -v '^#' | xargs) && electron-builder --mac --publish always",
    "dev": "NODE_ENV=development electron .",
    "lint": "eslint renderer.js main.js preload.js ui/*.js && stylelint 'css/*.css'",
    "lint:py": "cd .. && ruff check app/ src/ tests/",
    "format": "prettier --write renderer.js main.js preload.js ui/*.js && cd .. && ruff format app/ src/ tests/",
    "test:py": "cd .. && python3 -m pytest tests/ -v"
  },
  "author": "Plaud V2",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^41.1.0",
    "electron-builder": "^25.0.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "build": {
    "appId": "com.plaud.v2",
    "productName": "Plaud V2",
    "asar": false,
    "publish": {
      "provider": "github",
      "owner": "Obednal97",
      "repo": "Plaud-V2",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src"
      },
      {
        "from": "../keys",
        "to": "keys"
      }
    ]
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf"
}
